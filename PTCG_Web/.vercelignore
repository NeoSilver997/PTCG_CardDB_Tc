# Exclude local card images since we use official API images
cards/
*.png
*.jpg
*.jpeg
*.gif

# Explicitly include source/ directory for CSV data (needed for API)
!source/
!source/*.csv

# Exclude scripts and tools (be specific instead of *.js)
scripts/
batch-download.js
clean-names.js
debug-browser-sort.js
download-images.js
download-missing-images-batch.js
download-missing-images.js
example-deck.js
test-currency.ts
test-page.js
test-sorting.js
transform-market-prices.js
web_scraping_summary.txt

# Exclude documentation and logs
*.md
*.txt
*.json
!package.json
!package-lock.json
!tsconfig.json
!next-env.d.ts
!jest.config.js
!jest.setup.js
!postcss.config.mjs
!tailwind.config.js
!src/i18n/translations.js
!next.config.js

# Exclude build artifacts
.next/
node_modules/
*.tsbuildinfo

# Exclude test files
__tests__/
*.test.*
*.spec.*

# Exclude development files
.env.local
.gitignore
.vercelignore
.gitattributes

